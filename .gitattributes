# Receipts, fixtures and tests hash source bytes (git blob SHA / SHA-256), so the
# working tree must hold the same LF bytes on every platform. Without this,
# core.autocrlf=true on Windows rewrites checkouts to CRLF and breaks digests.
* text=auto eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.zip binary
*.xlsx binary
*.docx binary
*.pptx binary
